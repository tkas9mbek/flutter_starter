default_platform(:ios)
opt_out_usage

platform :ios do
  desc "Upload an already-built IPA (IPA_PATH) to TestFlight without waiting for processing"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APPSTORE_API_KEY_ID"),
      issuer_id: ENV.fetch("APPSTORE_ISSUER_ID"),
      key_filepath: ENV.fetch("APPSTORE_API_KEY_PATH"),
    )

    changelog = ENV["CHANGELOG"].to_s.strip

    upload_to_testflight(
      api_key: api_key,
      ipa: ENV.fetch("IPA_PATH"),
      skip_waiting_for_build_processing: true,
      skip_submission: true,
      distribute_external: false,
      changelog: changelog.empty? ? nil : changelog,
    )
  end
end
